OPENAI_API_KEY=sk-...
PORT=3001

# Supabase — required for Gallery feature
# Get these from: supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # use the service_role key (not anon)

# Gmail — required for Newsletter Reader
# Setup: node setup-gmail-oauth.js (follow the instructions it prints)
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=1//your-refresh-token

# Anthropic — used to auto-categorize newsletters
ANTHROPIC_API_KEY=sk-ant-...
